# Optional for plain `npm run dev`; `whop apps dev` supplies this binding.
WHOP_COMPANY_ID=biz_your_company_id

# Needed only when using plain `npm run dev`; `whop apps dev` supplies a temporary key.
# Keep this out of VITE_ variables and never commit the real key.
WHOP_API_KEY=your_server_side_whop_api_key

# Required only for the operator-only invoice tool. Set a unique random secret
# of at least 32 characters in local .env.local and as a Whop app secret.
# WHOP_INVOICE_ADMIN_TOKEN=
# Set WHOP_ENV=sandbox only when WHOP_API_KEY is a sandbox API key.
